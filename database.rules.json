{
  "rules": {
    "rate_limits": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["userId"]
    },
    "chats": {
      ".read": true,
      ".write": true,
      ".indexOn": ["lastMessageAt"]
    },
